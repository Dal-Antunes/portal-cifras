rules_version = '2';
// Regras do Portal de Cifras.
// - Todos leem as músicas oficiais.
// - Qualquer pessoa pode enviar uma música para aprovação (só entra na fila).
// - Todos leem os repertórios publicados; só o coordenador publica ou apaga.
// - Só o coordenador (a conta Google gravada em config/admin) aprova, recusa, edita ou exclui.
// - A primeira conta que tocar em "Tornar-me coordenador" vira o coordenador; depois disso ninguém mais consegue.
// - Modo Ao Vivo: todos leem a sala; só o coordenador muda a música. Quem entra pelo link só marca "estou aqui" (um horário).
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/config/admin)
        && get(/databases/$(database)/documents/config/admin).data.uid == request.auth.uid;
    }
    match /config/admin {
      allow read: if request.auth != null && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'criadoEm']);
      allow update, delete: if isAdmin();
    }
    match /musicas/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /repertorios/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /pendentes/{id} {
      allow create: if request.resource.data.keys().hasOnly(['tipo', 'musicaId', 'musica', 'autor', 'enviadoEm'])
        && request.resource.data.tipo in ['nova', 'edicao']
        && request.resource.data.musicaId is string && request.resource.data.musicaId.size() <= 40
        && request.resource.data.autor is string && request.resource.data.autor.size() <= 60
        && request.resource.data.musica is map
        && request.resource.data.musica.titulo is string && request.resource.data.musica.titulo.size() <= 200
        && request.resource.data.musica.cifra is string && request.resource.data.musica.cifra.size() <= 60000
        && request.resource.data.enviadoEm == request.time;
      allow read, update, delete: if isAdmin();
    }
    match /aovivo/{sala} {
      allow read: if sala.size() <= 40;
      allow write: if isAdmin() && sala.size() <= 40;
      match /pessoas/{aparelho} {
        allow read, delete: if isAdmin();
        allow create, update: if aparelho.size() <= 40
          && request.resource.data.keys().hasOnly(['visto'])
          && request.resource.data.visto == request.time;
      }
    }
    match /{caminho=**} {
      allow read, write: if false;
    }
  }
}
